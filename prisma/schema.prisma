generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Tek kullanıcılı panel: ayarlar tek satır (id = 1)
model Settings {
  id                Int      @id @default(1)
  niche             String   @default("")
  language          String   @default("tr")
  channelStyle      String   @default("Merak uyandıran, bilgilendirici, samimi")
  visualStyle       String   @default("flat 2D hand-drawn illustration, soft pastel colors, clean ink outlines, storybook style")
  elevenVoiceId     String   @default("")
  videosPerDay      Int      @default(1)
  publishTimes      String   @default("18:00") // virgülle ayrılmış HH:MM listesi
  timezone          String   @default("Europe/Istanbul")
  privacyStatus     String   @default("public") // public | unlisted | private
  imageProvider     String   @default("claude") // claude | fal | replicate | mock
  ttsProvider       String   @default("mock")   // mock | elevenlabs
  autoProduce       Boolean  @default(true)
  produceHoursAhead Int      @default(6)
  // API anahtarları ve bağlantılar (panelden girilir; boşsa .env'deki değer kullanılır)
  panelPassword      String  @default("")
  anthropicApiKey    String  @default("")
  claudeModel        String  @default("")
  elevenApiKey       String  @default("")
  elevenModelId      String  @default("")
  falKey             String  @default("")
  falModel           String  @default("")
  replicateToken     String  @default("")
  replicateModel     String  @default("")
  googleClientId     String  @default("")
  googleClientSecret String  @default("")
  appUrl             String  @default("")
  // Format: "info" (bilgi videosu) | "story" (etkileşimli hikâye dizisi)
  contentFormat      String  @default("info")
  seriesTitle        String  @default("")
  seriesPremise      String  @default("") // dizinin konusu/dünyası (boşsa Claude ilk bölümde oluşturur)
  seriesCharacters   String  @default("") // karakterlerin görsel tarifi (İngilizce, görsel tutarlılık için)
  storyMinutes       Float   @default(2.5)
  subtitleStyle      String  @default("karaoke") // karaoke | minimal | off
  watermark          String  @default("")
  musicVolume        Float   @default(0.12) // music/ klasöründeki mp3'ler için
  musicSource        String  @default("folder") // off | folder | eleven (ElevenLabs ile üret)
  musicPrompt        String  @default("")       // ElevenLabs müzik tarifi (boşsa formata göre)
  sfx                Boolean @default(true)     // sahne geçişlerinde hafif "whoosh" sesi
  particles          Boolean @default(true)     // havada süzülen toz/ışık parçacıkları
  progressBar        Boolean @default(true)     // üstte ilerleme çubuğu
  hookText           Boolean @default(true)     // bilgi videolarında ilk saniyelerde büyük başlık
  // TikTok (developers.tiktok.com uygulaması) ve Meta (Instagram) bağlantı bilgileri
  tiktokClientKey    String  @default("")
  tiktokClientSecret String  @default("")
  tiktokRedirectUri  String  @default("")
  metaAppId          String  @default("")
  metaAppSecret      String  @default("")
  updatedAt         DateTime @updatedAt
}

model YoutubeAccount {
  id           Int      @id @default(1)
  channelId    String
  channelTitle String
  accessToken  String
  refreshToken String
  expiryDate   DateTime?
  updatedAt    DateTime @updatedAt
}

// Kanal / marka: her uygulama (Randıman, Asistena…) kendi içeriği, görünümü ve hesaplarıyla
model Channel {
  id               String   @id @default(cuid())
  name             String
  // Format: info (bilgi) | story (etkileşimli hikâye) | promo (ürün tanıtımı)
  contentFormat    String   @default("info")
  niche            String   @default("")
  language         String   @default("tr")
  channelStyle     String   @default("Merak uyandıran, bilgilendirici, samimi")
  visualStyle      String   @default("")
  elevenVoiceId    String   @default("")
  videosPerDay     Int      @default(1)
  publishTimes     String   @default("18:00")
  privacyStatus    String   @default("public")
  autoProduce      Boolean  @default(true)
  subtitleStyle    String   @default("karaoke")
  watermark        String   @default("")
  musicPrompt      String   @default("")
  // Hikâye dizisi
  seriesTitle      String   @default("")
  seriesPremise    String   @default("")
  seriesCharacters String   @default("")
  storyMinutes     Float    @default(2.5)
  // Ürün / marka
  productName      String   @default("")
  productUrl       String   @default("")
  productProblem   String   @default("") // çözdüğü sorun
  productFeatures  String   @default("") // satır satır özellikler
  targetAudience   String   @default("")
  cta              String   @default("") // ör. "Ücretsiz demo için: randiman.com"
  sectors          String   @default("") // satış videoları için sektörler (satır satır)
  primaryColor     String   @default("#ffd27a")
  accentColor      String   @default("#e6303b")
  logoPath         String?
  // Hangi platformlara otomatik yüklenecek
  toYoutube        Boolean  @default(true)
  toTiktok         Boolean  @default(false)
  toInstagram      Boolean  @default(false)
  tiktokMode       String   @default("draft") // draft (TikTok uygulamasında taslak) | direct
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  items            ContentItem[]
  connections      Connection[]
}

// Kanalın platform hesapları (YouTube, TikTok, Instagram)
model Connection {
  id           String    @id @default(cuid())
  channelId    String
  channel      Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  platform     String    // youtube | tiktok | instagram
  accountId    String
  accountName  String
  accessToken  String
  refreshToken String    @default("")
  expiresAt    DateTime?
  extra        String    @default("{}") // JSON: platforma özel bilgiler
  updatedAt    DateTime  @updatedAt

  @@unique([channelId, platform])
}

model ContentItem {
  id             String    @id @default(cuid())
  channelId      String?
  channel        Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  // standard (takvim/yeni video) | sales (sektöre özel satış videosu) | clip (yüklenen demo videosundan)
  kind           String    @default("standard")
  sector         String?
  shareText      String?   // satış videosu ile müşteriye gönderilecek mesaj
  sourceVideo    String?   // clip: yüklenen kaynak video yolu
  tiktokId       String?
  instagramId    String?
  platformLog    String?   // JSON: {tiktok: "hata/ok", instagram: ...}
  dayIndex       Int
  publishAt      DateTime
  topic          String
  hook           String
  script         String
  title          String
  description    String
  tags           String    // JSON dizi
  // WRITING (Claude metni yazıyor) / DRAFT -> APPROVED -> PRODUCING -> READY -> UPLOADING -> UPLOADED | FAILED
  status         String    @default("DRAFT")
  scenes         String?   // JSON: [{text, imagePrompt, start, end, image}]
  audioPath      String?
  videoPath      String?
  youtubeVideoId String?
  error          String?
  attempts       Int       @default(0)
  autoUpload     Boolean   @default(true) // false: hazır olunca bekler, elle yüklenir
  // Hikâye dizisi alanları
  episodeNumber  Int?
  choiceA        String?
  choiceB        String?
  summary        String?   // bölüm özeti (sonraki bölümlerin devamlılığı için)
  votesA         Int?
  votesB         Int?
  chosen         String?   // bu bölümü başlatan, önceki bölümde seçilen seçenek
  progress       String?   // üretim aşaması, ör. "Görseller 4/12"
  // YouTube istatistikleri (saatlik güncellenir)
  views          Int?
  likes          Int?
  comments       Int?
  statsAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  logs           JobLog[]

  @@index([status, publishAt])
  @@index([channelId, status])
}

model JobLog {
  id        Int         @id @default(autoincrement())
  itemId    String?
  item      ContentItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  level     String      @default("info")
  message   String
  createdAt DateTime    @default(now())
}
