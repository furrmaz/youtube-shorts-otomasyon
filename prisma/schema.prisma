generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Tek kullanıcılı panel: ayarlar tek satır (id = 1)
model Settings {
  id                Int      @id @default(1)
  niche             String   @default("")
  language          String   @default("tr")
  channelStyle      String   @default("Merak uyandıran, bilgilendirici, samimi")
  visualStyle       String   @default("flat 2D hand-drawn illustration, soft pastel colors, clean ink outlines, storybook style")
  elevenVoiceId     String   @default("")
  videosPerDay      Int      @default(1)
  publishTimes      String   @default("18:00") // virgülle ayrılmış HH:MM listesi
  timezone          String   @default("Europe/Istanbul")
  privacyStatus     String   @default("public") // public | unlisted | private
  imageProvider     String   @default("mock")   // mock | fal | replicate
  ttsProvider       String   @default("mock")   // mock | elevenlabs
  autoProduce       Boolean  @default(true)
  produceHoursAhead Int      @default(6)
  // API anahtarları ve bağlantılar (panelden girilir; boşsa .env'deki değer kullanılır)
  panelPassword      String  @default("")
  anthropicApiKey    String  @default("")
  claudeModel        String  @default("")
  elevenApiKey       String  @default("")
  elevenModelId      String  @default("")
  falKey             String  @default("")
  falModel           String  @default("")
  replicateToken     String  @default("")
  replicateModel     String  @default("")
  googleClientId     String  @default("")
  googleClientSecret String  @default("")
  appUrl             String  @default("")
  updatedAt         DateTime @updatedAt
}

model YoutubeAccount {
  id           Int      @id @default(1)
  channelId    String
  channelTitle String
  accessToken  String
  refreshToken String
  expiryDate   DateTime?
  updatedAt    DateTime @updatedAt
}

model ContentItem {
  id             String    @id @default(cuid())
  dayIndex       Int
  publishAt      DateTime
  topic          String
  hook           String
  script         String
  title          String
  description    String
  tags           String    // JSON dizi
  // WRITING (Claude metni yazıyor) / DRAFT -> APPROVED -> PRODUCING -> READY -> UPLOADING -> UPLOADED | FAILED
  status         String    @default("DRAFT")
  scenes         String?   // JSON: [{text, imagePrompt, start, end, image}]
  audioPath      String?
  videoPath      String?
  youtubeVideoId String?
  error          String?
  attempts       Int       @default(0)
  autoUpload     Boolean   @default(true) // false: hazır olunca bekler, elle yüklenir
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  logs           JobLog[]

  @@index([status, publishAt])
}

model JobLog {
  id        Int         @id @default(autoincrement())
  itemId    String?
  item      ContentItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  level     String      @default("info")
  message   String
  createdAt DateTime    @default(now())
}
