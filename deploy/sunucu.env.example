# Sunucu ayarları. deploy/kurulum.sh bu dosyayı sizin için .env olarak oluşturur.
# API anahtarları (Claude, ElevenLabs, Google...) yine panelden girilir.

# Panelin açılacağı alan adı (DNS'te A kaydı sunucunun IP adresine yönlenmeli)
DOMAIN=panel.ornek.com

# Panel giriş şifresi (zorunlu: panel internete açık)
PANEL_PASSWORD=

# Saat dilimi
TZ=Europe/Istanbul
