# Veritabanı (SQLite dosyası). Başka bir şey girmeniz gerekmez:
# tüm API anahtarları ve ayarlar panelden (Ayarlar sayfası) girilir.
DATABASE_URL="file:./dev.db"

# İsteğe bağlı: panel yerine buradan da verilebilir (panelde girilen değer önceliklidir)
# ANTHROPIC_API_KEY=""
# ELEVENLABS_API_KEY=""
# FAL_KEY=""
# REPLICATE_API_TOKEN=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# PANEL_PASSWORD=""
# APP_URL="http://localhost:3000"
# MEDIA_DIR="./media"
# FFMPEG_PATH / FFPROBE_PATH: ffmpeg PATH'te değilse tam yolu
